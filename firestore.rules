rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /sags_auth_lookup/{username} {
      allow read: if true;
      allow write: if false;
    }

    match /sags_auth_users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // V1.4 runtime compatibility. Tighten after all operational clients
    // are confirmed to use Firebase Authentication for request.auth.
    match /sags_handovers/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
